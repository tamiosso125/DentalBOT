{
  "mcpServers": {
    "whatsapp-sandbox": {
      "command": "pnpm",
      "args": ["--silent", "sandbox:mcp"],
      "env": {
        "DENTALBOT_URL": "http://localhost:3000"
      }
    },
    "dentalbot-agenda": {
      "command": "pnpm",
      "args": ["--silent", "agenda:mcp"],
      "env": {
        "AGENDA_SOURCE": "memory"
      }
    }
  }
}
