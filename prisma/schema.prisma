// DentalBOT data model.
// Sensitive fields (phone, CPF, insurance card, message bodies) are stored encrypted
// (AES-256-GCM, see src/privacy/crypto.ts) with an HMAC hash column for lookups.
// Never read or write them without going through src/privacy.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Clinic setup ----------

model Clinic {
  id                    String   @id @default(cuid())
  name                  String
  timezone              String   @default("America/Sao_Paulo")
  whatsappPhoneNumberId String?  @unique
  address               String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  dentists         Dentist[]
  procedures       Procedure[]
  insurancePlans   InsurancePlan[]
  patients         Patient[]
  appointments     Appointment[]
  quotes           Quote[]
  conversations    Conversation[]
  dataRequests     DataSubjectRequest[]
  waitlist         WaitlistEntry[]
  surveys          SatisfactionSurvey[]
  aftercare        AftercareFollowUp[]
  authorizations   InsuranceAuthorization[]
  clinicPayments   ClinicPayment[]
  patientNotes     PatientNote[]
  accessLogs       AccessLog[]
  staffUsers       StaffUser[]
  medicalHistories MedicalHistory[]
  clinicalEntries  ClinicalEntry[]
}

model Dentist {
  id        String   @id @default(cuid())
  clinicId  String
  name      String
  cro       String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  clinic         Clinic          @relation(fields: [clinicId], references: [id])
  workingHours   WorkingHours[]
  scheduleBlocks ScheduleBlock[]
  appointments   Appointment[]
  quotes         Quote[]
  waitlistOffers WaitlistOffer[]

  @@index([clinicId])
}

model Procedure {
  id              String  @id @default(cuid())
  clinicId        String
  name            String
  durationMinutes Int
  /// Private (particular) price, in cents. Null = price only after evaluation.
  priceCents      Int?
  active          Boolean @default(true)
  /// Care instructions written by the dentist, sent after the patient attends
  /// (orientacoes_pos_procedimento). Null = nothing is sent for this procedure.
  aftercareText   String?

  clinic         Clinic              @relation(fields: [clinicId], references: [id])
  coverages      InsuranceCoverage[]
  appointments   Appointment[]
  quoteItems     QuoteItem[]
  waitlist       WaitlistEntry[]
  clinicPayments ClinicPayment[]

  @@unique([clinicId, name])
}

model InsurancePlan {
  id       String @id @default(cuid())
  clinicId String
  /// e.g. "Odontoprev"
  name     String

  clinic         Clinic                   @relation(fields: [clinicId], references: [id])
  coverages      InsuranceCoverage[]
  patients       Patient[]
  authorizations InsuranceAuthorization[]

  @@unique([clinicId, name])
}

model InsuranceCoverage {
  insurancePlanId       String
  procedureId           String
  covered               Boolean @default(true)
  /// Prior authorization is done manually by the front desk on the insurer portal.
  requiresAuthorization Boolean @default(false)

  insurancePlan InsurancePlan @relation(fields: [insurancePlanId], references: [id])
  procedure     Procedure     @relation(fields: [procedureId], references: [id])

  @@id([insurancePlanId, procedureId])
}

model WorkingHours {
  id          String @id @default(cuid())
  dentistId   String
  /// 0 = Sunday ... 6 = Saturday
  weekday     Int
  /// Minutes since midnight, clinic timezone.
  startMinute Int
  endMinute   Int

  dentist Dentist @relation(fields: [dentistId], references: [id])

  @@index([dentistId, weekday])
}

model ScheduleBlock {
  id        String   @id @default(cuid())
  dentistId String
  startsAt  DateTime
  endsAt    DateTime
  reason    String?

  dentist Dentist @relation(fields: [dentistId], references: [id])

  @@index([dentistId, startsAt])
}

// ---------- Patients and consent ----------

model Patient {
  id                     String    @id @default(cuid())
  clinicId               String
  name                   String
  phoneHash              String
  phoneEncrypted         String
  cpfHash                String?
  cpfEncrypted           String?
  birthDate              DateTime? @db.Date
  insurancePlanId        String?
  insuranceCardEncrypted String?
  asaasCustomerId        String?
  /// LGPD erasure: personal fields were wiped at this moment (financial records stay).
  anonymizedAt           DateTime?
  /// When the recall invitation ("convite_retorno") went out; one per last visit.
  recallInvitedAt        DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  clinic           Clinic                   @relation(fields: [clinicId], references: [id])
  insurancePlan    InsurancePlan?           @relation(fields: [insurancePlanId], references: [id])
  consents         Consent[]
  appointments     Appointment[]
  quotes           Quote[]
  conversations    Conversation[]
  waitlist         WaitlistEntry[]
  surveys          SatisfactionSurvey[]
  aftercare        AftercareFollowUp[]
  authorizations   InsuranceAuthorization[]
  clinicPayments   ClinicPayment[]
  notes            PatientNote[]
  medicalHistories MedicalHistory[]
  clinicalEntries  ClinicalEntry[]

  @@unique([clinicId, phoneHash])
  @@index([clinicId, cpfHash])
}

enum ConsentPurpose {
  PRIVACY_NOTICE
  MARKETING
}

enum ConsentSource {
  /// Recorded by the front desk in the panel.
  STAFF
  /// The patient answered the bot's buttons.
  WHATSAPP
}

model Consent {
  id          String         @id @default(cuid())
  patientId   String
  purpose     ConsentPurpose
  granted     Boolean
  /// Version of the text the patient saw when granting/revoking.
  textVersion String
  source      ConsentSource  @default(STAFF)
  createdAt   DateTime       @default(now())

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId, purpose, createdAt])
}

// ---------- Scheduling ----------

enum AppointmentStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  CANCELLED
  NO_SHOW
  COMPLETED
}

model Appointment {
  id                   String            @id @default(cuid())
  clinicId             String
  patientId            String
  dentistId            String
  procedureId          String
  startsAt             DateTime
  endsAt               DateTime
  status               AppointmentStatus @default(PENDING_CONFIRMATION)
  /// When the day-before reminder went out (cleared when the appointment moves).
  reminderSentAt       DateTime?
  /// When the front desk last resent the confirmation by hand (cleared when the appointment moves).
  confirmationResentAt DateTime?
  /// When the "we missed you" message (consulta_perdida) went out after a no-show.
  noShowNoticeAt       DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  clinic          Clinic                  @relation(fields: [clinicId], references: [id])
  patient         Patient                 @relation(fields: [patientId], references: [id])
  dentist         Dentist                 @relation(fields: [dentistId], references: [id])
  procedure       Procedure               @relation(fields: [procedureId], references: [id])
  survey          SatisfactionSurvey?
  authorization   InsuranceAuthorization?
  aftercare       AftercareFollowUp?
  clinicalEntries ClinicalEntry[]

  @@index([dentistId, startsAt])
  @@index([patientId])
  @@index([status, startsAt])
}

enum AuthorizationStatus {
  AUTHORIZED
  DENIED
}

/// The front desk's answer from the insurer's portal for an appointment that needs prior
/// authorization. Pending ones have no row: they are derived from plan coverage.
model InsuranceAuthorization {
  id              String              @id @default(cuid())
  clinicId        String
  appointmentId   String              @unique
  patientId       String
  insurancePlanId String
  status          AuthorizationStatus
  decidedAt       DateTime
  /// When the patient got the result (template); null if the send failed.
  notifiedAt      DateTime?
  /// Denied, then the patient chose "Seguir como particular".
  privateChosenAt DateTime?

  clinic        Clinic        @relation(fields: [clinicId], references: [id])
  appointment   Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient       Patient       @relation(fields: [patientId], references: [id])
  insurancePlan InsurancePlan @relation(fields: [insurancePlanId], references: [id])

  @@index([clinicId, decidedAt])
}

/// One satisfaction question per attended appointment, sent the day after (pesquisa_satisfacao).
model SatisfactionSurvey {
  id            String    @id @default(cuid())
  clinicId      String
  appointmentId String    @unique
  patientId     String
  sentAt        DateTime
  /// 1 (worst) to 5 (best); null until the patient taps a button.
  rating        Int?
  answeredAt    DateTime?

  clinic      Clinic      @relation(fields: [clinicId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient     Patient     @relation(fields: [patientId], references: [id])

  @@index([clinicId, sentAt])
  @@index([patientId, sentAt])
}

/// Medical history (anamnese) filled in by the staff in the panel. Every save is a new row,
/// so earlier versions stay; the newest is the current one. The whole form is health data:
/// it lives encrypted as JSON (src/panel/medical-history.ts). The bot never reads it.
model MedicalHistory {
  id            String   @id @default(cuid())
  clinicId      String
  patientId     String
  dataEncrypted String
  staffUserId   String?
  createdAt     DateTime @default(now())

  clinic    Clinic     @relation(fields: [clinicId], references: [id])
  patient   Patient    @relation(fields: [patientId], references: [id])
  staffUser StaffUser? @relation(fields: [staffUserId], references: [id])

  @@index([patientId, createdAt])
}

/// Clinical record entry (evolução clínica) signed by the dentist. Never updated or deleted:
/// a correction is a new entry that points at the one it amends (amendsId).
model ClinicalEntry {
  id            String   @id @default(cuid())
  clinicId      String
  patientId     String
  appointmentId String
  /// Set when this entry is an addendum to an earlier one.
  amendsId      String?
  dataEncrypted String
  staffUserId   String?
  createdAt     DateTime @default(now())

  clinic      Clinic          @relation(fields: [clinicId], references: [id])
  patient     Patient         @relation(fields: [patientId], references: [id])
  appointment Appointment     @relation(fields: [appointmentId], references: [id])
  staffUser   StaffUser?      @relation(fields: [staffUserId], references: [id])
  amends      ClinicalEntry?  @relation("ClinicalAmends", fields: [amendsId], references: [id])
  addenda     ClinicalEntry[] @relation("ClinicalAmends")

  @@index([patientId, createdAt])
  @@index([appointmentId])
}

enum StaffRole {
  RECEPTION
  DENTIST
}

/// A person of the clinic's staff with a panel login. Never deleted, only deactivated, so the
/// access log and notes keep pointing at them. The e-mail is personal data: hash + encrypted.
model StaffUser {
  id             String    @id @default(cuid())
  clinicId       String
  name           String
  role           StaffRole
  emailHash      String
  emailEncrypted String
  /// scrypt, see src/staff/password.ts.
  passwordHash   String
  active         Boolean   @default(true)
  failedLogins   Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())

  clinic           Clinic           @relation(fields: [clinicId], references: [id])
  accessLogs       AccessLog[]
  notes            PatientNote[]
  medicalHistories MedicalHistory[]
  clinicalEntries  ClinicalEntry[]

  @@unique([clinicId, emailHash])
}

/// What the staff did with patient data in the panel. Never holds content: only the action,
/// when, and which patient or record. Old entries are purged (ACCESS_LOG_RETENTION_DAYS).
enum AccessAction {
  SEARCH_PATIENTS
  VIEW_RECORD
  VIEW_DATA
  EXPORT_DATA
  ANONYMIZE
  VIEW_NOTES
  ADD_NOTE
  DELETE_NOTE
  VIEW_INSURANCE
  SET_INSURANCE
  SET_CONSENT
  VIEW_APPOINTMENT
  VIEW_QUOTE
  VIEW_QUOTE_PDF
  RECEIVE_INSTALLMENT
  REGISTER_CLINIC_PAYMENT
  VIEW_ACCESS_LOG
  LOGIN
  MANAGE_STAFF
  VIEW_MEDICAL_HISTORY
  SET_MEDICAL_HISTORY
  VIEW_CLINICAL_RECORD
  ADD_CLINICAL_ENTRY
  ISSUE_ATTENDANCE_CERTIFICATE
  PRINT_DAY_SHEET
}

model AccessLog {
  id          String       @id @default(cuid())
  clinicId    String
  action      AccessAction
  /// No foreign key: the entry outlives anything that happens to the patient row.
  patientId   String?
  /// The appointment, quote, installment or data request the action was about.
  targetId    String?
  /// Who was signed in to the panel; null for calls made without a staff login.
  staffUserId String?
  at          DateTime     @default(now())
  clinic      Clinic       @relation(fields: [clinicId], references: [id])
  staffUser   StaffUser?   @relation(fields: [staffUserId], references: [id])

  @@index([clinicId, at])
  @@index([clinicId, patientId, at])
}

enum NoteAuthor {
  RECEPTION
  DENTIST
}

/// Internal note of the clinic staff about a patient ("Anotações" on the patient record).
/// May hold health information, so the text is encrypted. Never shown to the patient or
/// to the LLM.
model PatientNote {
  id            String     @id @default(cuid())
  clinicId      String
  patientId     String
  author        NoteAuthor
  textEncrypted String
  /// Who wrote it, when signed in with a personal login.
  staffUserId   String?
  createdAt     DateTime   @default(now())

  clinic    Clinic     @relation(fields: [clinicId], references: [id])
  patient   Patient    @relation(fields: [patientId], references: [id])
  staffUser StaffUser? @relation(fields: [staffUserId], references: [id])

  @@index([patientId, createdAt])
}

enum AftercareAnswer {
  /// "Tudo bem"
  OK
  /// "Preciso de ajuda": the front desk was called.
  HELP
}

/// Care instructions sent after an attended appointment, and the next-day check-in
/// (acompanhamento_pos_procedimento) with "Tudo bem" / "Preciso de ajuda".
model AftercareFollowUp {
  id                 String           @id @default(cuid())
  clinicId           String
  appointmentId      String           @unique
  patientId          String
  instructionsSentAt DateTime
  checkInSentAt      DateTime?
  answer             AftercareAnswer?
  answeredAt         DateTime?

  clinic      Clinic      @relation(fields: [clinicId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient     Patient     @relation(fields: [patientId], references: [id])

  @@index([clinicId, checkInSentAt])
  @@index([patientId])
}

enum WaitlistStatus {
  WAITING
  /// The patient took an offered slot.
  BOOKED
  /// Taken off the list by the front desk (or the patient was anonymized).
  REMOVED
  /// No slot opened before the date the patient wanted.
  EXPIRED
}

/// A patient waiting for an earlier slot of a procedure. Freed slots starting before
/// `until` are offered by template (vaga_disponivel); the first to accept takes it.
model WaitlistEntry {
  id            String         @id @default(cuid())
  clinicId      String
  patientId     String
  procedureId   String
  /// Only slots starting before this moment are offered.
  until         DateTime
  status        WaitlistStatus @default(WAITING)
  /// Appointment booked (or moved) when an offer was accepted.
  appointmentId String?
  createdAt     DateTime       @default(now())
  closedAt      DateTime?

  clinic    Clinic          @relation(fields: [clinicId], references: [id])
  patient   Patient         @relation(fields: [patientId], references: [id])
  procedure Procedure       @relation(fields: [procedureId], references: [id])
  offers    WaitlistOffer[]

  @@index([clinicId, status, createdAt])
  @@index([patientId])
}

enum WaitlistAnswer {
  ACCEPTED
  DECLINED
  /// Accepted, but someone else had taken the slot.
  TAKEN
}

/// One slot offered to one waiting patient (never the same slot twice to the same entry).
model WaitlistOffer {
  id         String          @id @default(cuid())
  entryId    String
  dentistId  String
  startsAt   DateTime
  endsAt     DateTime
  sentAt     DateTime
  answer     WaitlistAnswer?
  answeredAt DateTime?

  entry   WaitlistEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  dentist Dentist       @relation(fields: [dentistId], references: [id])

  @@unique([entryId, dentistId, startsAt])
  @@index([dentistId, startsAt, sentAt])
}

// ---------- Quotes and billing ----------

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum CoverageType {
  PRIVATE
  INSURANCE
}

model Quote {
  id               String      @id @default(cuid())
  clinicId         String
  patientId        String
  dentistId        String
  status           QuoteStatus @default(DRAFT)
  /// Sum of PRIVATE items, in cents. Insurance-covered items are not charged.
  totalCents       Int
  /// Number of monthly installments offered for the private total.
  installmentCount Int         @default(1)
  /// Free text from the dentist shown on the PDF (no diagnosis details).
  notes            String?
  validUntil       DateTime?   @db.Date
  sentAt           DateTime?
  respondedAt      DateTime?
  /// When the one "still waiting for your answer" reminder went out.
  reminderSentAt   DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  patient      Patient       @relation(fields: [patientId], references: [id])
  dentist      Dentist       @relation(fields: [dentistId], references: [id])
  items        QuoteItem[]
  installments Installment[]

  @@index([clinicId, status])
}

model QuoteItem {
  id             String       @id @default(cuid())
  quoteId        String
  procedureId    String?
  description    String
  quantity       Int          @default(1)
  unitPriceCents Int
  coverage       CoverageType @default(PRIVATE)

  quote     Quote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  procedure Procedure? @relation(fields: [procedureId], references: [id])
}

enum InstallmentStatus {
  PENDING
  BILLED
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  PIX
  BOLETO
  CREDIT_CARD
  /// Received at the front desk.
  CASH
  DEBIT_CARD
}

model Installment {
  id               String            @id @default(cuid())
  quoteId          String
  number           Int
  amountCents      Int
  dueDate          DateTime          @db.Date
  status           InstallmentStatus @default(PENDING)
  paymentMethod    PaymentMethod?
  /// Asaas payment id (pay_...).
  asaasPaymentId   String?           @unique
  paidAt           DateTime?
  /// When the WhatsApp reminder with the payment link went out (one per installment).
  reminderSentAt   DateTime?
  /// When the "your installment is past due" notice went out (one per installment).
  overdueNoticeAt  DateTime?
  /// Paid at the front desk (recorded in the panel), not through the Asaas invoice.
  receivedAtClinic Boolean           @default(false)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, number])
  @@index([status, dueDate])
}

/// Asaas webhook events already processed (Asaas may deliver the same event twice).
/// Money received at the front desk outside any quote installment (e.g. a visit paid in cash).
model ClinicPayment {
  id          String        @id @default(cuid())
  clinicId    String
  patientId   String
  procedureId String?
  amountCents Int
  method      PaymentMethod
  /// Noon of the day it was received, in the clinic's timezone.
  paidAt      DateTime
  createdAt   DateTime      @default(now())
  /// Undone by the front desk (typed by mistake). Kept for the record.
  voidedAt    DateTime?

  clinic    Clinic     @relation(fields: [clinicId], references: [id])
  patient   Patient    @relation(fields: [patientId], references: [id])
  procedure Procedure? @relation(fields: [procedureId], references: [id])

  @@index([clinicId, paidAt])
  @@index([patientId])
}

model PaymentEvent {
  id         String   @id
  event      String
  receivedAt DateTime @default(now())
}

// ---------- WhatsApp conversations ----------

model Conversation {
  id                   String    @id @default(cuid())
  clinicId             String
  patientId            String?
  contactHash          String
  contactEncrypted     String
  /// Bot stays silent until this moment (human handoff or front desk replying via the app).
  botPausedUntil       DateTime?
  /// Last patient message; free-form replies are only allowed within 24h of it.
  lastInboundAt        DateTime?
  privacyNoticeAt      DateTime?
  /// Patient replied "PARAR": no marketing/recall messages until they opt in again.
  marketingOptOutAt    DateTime?
  /// The bot asked once whether the patient wants recall invitations (after a confirmation).
  recallConsentAskedAt DateTime?
  /// Orchestrator working memory: offered slot options and numbered appointments (ids and
  /// times only, never message text or health data).
  agentState           Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  clinic   Clinic    @relation(fields: [clinicId], references: [id])
  patient  Patient?  @relation(fields: [patientId], references: [id])
  messages Message[]

  @@unique([clinicId, contactHash])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  /// Sent by the front desk through the WhatsApp Business app (coexistence echo).
  ECHO
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  waMessageId    String?          @unique
  direction      MessageDirection
  type           String
  bodyEncrypted  String?
  status         String?
  createdAt      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, createdAt])
}

enum DataRequestStatus {
  OPEN
  DONE
}

/// LGPD data subject requests ("MEUS DADOS").
model DataSubjectRequest {
  id             String            @id @default(cuid())
  clinicId       String
  conversationId String
  status         DataRequestStatus @default(OPEN)
  createdAt      DateTime          @default(now())
  resolvedAt     DateTime?

  clinic Clinic @relation(fields: [clinicId], references: [id])
}
