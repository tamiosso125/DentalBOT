# Copie para .env e ajuste. Nunca faça commit do .env.
# Valores marcados com [CONTA] só existem depois de abrir a conta correspondente.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Banco e fila (docker compose up -d sobe os dois)
DATABASE_URL=postgresql://dentalbot:dentalbot@localhost:5432/dentalbot
# memory = fila em processo (dev); redis = BullMQ (produção)
QUEUE_MODE=memory
REDIS_URL=redis://localhost:6379

# Criptografia de dados sensíveis. Gere com: openssl rand -base64 32
PII_ENCRYPTION_KEY=troque-por-openssl-rand-base64-32
PII_HASH_SECRET=troque-por-um-segredo-longo-de-32-caracteres-ou-mais

# Clínica usada enquanto o número de WhatsApp não está ligado (saída do pnpm db:seed)
DEFAULT_CLINIC_ID=clinic_dev
PRIVACY_POLICY_URL=https://example.com/privacidade
HANDOFF_PAUSE_MINUTES=240

# WhatsApp Cloud API
# sandbox = mensagens ficam em memória (GET /dev/sandbox/outbox); cloud = Meta de verdade
WHATSAPP_MODE=sandbox
# Você escolhe; o mesmo valor vai no painel da Meta ao cadastrar o webhook
WHATSAPP_VERIFY_TOKEN=dev-verify-token-troque
# [CONTA Meta] App Secret do app na Meta (em sandbox, qualquer valor de 16+ caracteres)
WHATSAPP_APP_SECRET=dev-app-secret-troque
# [CONTA Meta] token de usuário do sistema e ID do número (só em WHATSAPP_MODE=cloud)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0

# Asaas
# mock = sem conta; sandbox = api-sandbox.asaas.com; production = api.asaas.com
ASAAS_ENV=mock
# [CONTA Asaas] chave de API (sandbox ou produção)
ASAAS_API_KEY=
# Você escolhe; o mesmo valor vai no cadastro do webhook no Asaas
ASAAS_WEBHOOK_TOKEN=dev-asaas-webhook-token-troque
