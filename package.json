{
  "name": "dentalbot",
  "version": "0.1.0",
  "private": true,
  "description": "Chatbot de WhatsApp para clínica odontológica: agendamento, orçamentos e cobrança.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run tests/e2e tests/integration",
    "eval": "tsx scripts/run-eval.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "sandbox:mcp": "tsx tools/mcp/whatsapp-sandbox.ts",
    "agenda:mcp": "tsx tools/mcp/dentalbot-agenda.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.134.0",
    "@prisma/client": "6.19.3",
    "bullmq": "5.63.0",
    "fastify": "5.12.7",
    "ioredis": "5.8.2",
    "pdfkit": "0.20.2",
    "pino": "10.1.0",
    "prisma": "6.19.3",
    "yaml": "2.8.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/node": "22.19.1",
    "@types/pdfkit": "0.17.6",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-ggr8-5vv4-36mx"
      ]
    },
    "overrides": {
      "postcss": ">=8.5.23",
      "yaml": ">=2.8.3"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
